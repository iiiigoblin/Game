{
  "name": "dsh-permission-converge",
  "version": "1.0.0",
  "description": "Adds the Converge permission preset to DeepSeek Harness: full file access with the approval channel kept open.",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "deepseek-harness",
    "permission"
  ],
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
